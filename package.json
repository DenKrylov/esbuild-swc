{
  "name": "esbuild-swc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:app:dev",
    "build": "npm run build:app:prod && npm run build:lib:prod && npm run build:lib:swc",
    "lint": "eslint .",
    "preview": "npm run build:app:prod && node scripts/preview.mjs",
    "build:app:dev": "tsx build-hw/configs/esbuild.app.config.ts --mode=dev",
    "build:app:prod": "tsx build-hw/configs/esbuild.app.config.ts --mode=prod",
    "build:lib:dev": "tsx build-hw/configs/esbuild.lib.config.ts --mode=dev",
    "build:lib:prod": "tsx build-hw/configs/esbuild.lib.config.ts --mode=prod",
    "build:lib:swc": "tsx build-hw/configs/swc.lib.config.ts"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@swc/core": "^1.6.7",
    "@types/lodash": "^4.17.13",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
